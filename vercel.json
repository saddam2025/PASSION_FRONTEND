{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/ar/courses/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": "(?i).*(facebookexternalhit|facebot|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot).*"
          }
        }
      ],
      "destination": "https://passionbackend-production.up.railway.app/api/v1/seo/courses/:slug"
    },
    {
      "source": "/courses/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": "(?i).*(facebookexternalhit|facebot|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot).*"
          }
        }
      ],
      "destination": "https://passionbackend-production.up.railway.app/api/v1/seo/courses/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://passionbackend-production.up.railway.app/api/v1/seo/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://passionbackend-production.up.railway.app/api/v1/seo/robots.txt"
    },
    {
      "source": "/api/:path*",
      "destination": "https://passionbackend-production.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "value": "no-store, no-cache, must-revalidate",
          "key": "Cache-Control"
        }
      ]
    },
    {
      "source": "/ar",
      "headers": [
        {
          "value": "no-store, no-cache, must-revalidate",
          "key": "Cache-Control"
        }
      ]
    },
    {
      "source": "/ar/(.*)",
      "headers": [
        {
          "value": "no-store, no-cache, must-revalidate",
          "key": "Cache-Control"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "value": "no-store, no-cache, must-revalidate",
          "key": "Cache-Control"
        }
      ]
    },
    {
      "source": "/ar/courses/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://media.example.com https://pub-1bc4a1e4bc624afbb734c694ab29f433.r2.dev https://www.facebook.com; font-src 'self'; connect-src 'self' https://www.facebook.com https://connect.facebook.net; frame-src 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
